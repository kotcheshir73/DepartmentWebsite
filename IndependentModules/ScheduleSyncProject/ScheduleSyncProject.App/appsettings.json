{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs\\log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Properties": {
      "Application": "ScheduleSyncProject.App"
    }
  },

  "TimeTableAPISettings": {
    "BaseUrl": "http://vml1.ustu:8080/api/1.0/"
  },

  "DatabaseSettings": {
    "ConnectionString": "Data Source=10.3.1.13\\SQLEXPRESS;Initial Catalog=DepartmentDatabaseContext;persist security info=True;user id=sa;password=isadmin;MultipleActiveResultSets=True;TrustServerCertificate=True;Encrypt=false;"
  }
}